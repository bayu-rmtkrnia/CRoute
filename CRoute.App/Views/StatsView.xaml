<UserControl x:Class="CRoute.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CRoute.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,12">
            <TextBlock Text="Statistik &amp; Target" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Pantau emisimu dan atur target pengurangan karbon bulanan."
                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="Target emisi bulan ini" FontWeight="SemiBold" FontSize="16"
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalText}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource DeepGreenBrush}"/>
                        <TextBlock Text="{Binding OfTargetText}" Style="{StaticResource Muted}" FontSize="15"
                                   VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource SoftProgress}" Height="12" Minimum="0" Maximum="100"
                                 Margin="0,8,0,0" Value="{Binding TargetPercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>

                    <TextBlock Text="Ubah target (kg CO₂ per bulan)" Style="{StaticResource Muted}"
                               Margin="0,20,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource InputBox}" Width="140"
                                 Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Simpan target" Style="{StaticResource PrimaryButton}"
                                Width="160" Height="44" Margin="12,0,0,0" Command="{Binding SaveTargetCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TargetMessage}" Margin="0,8,0,0"
                               Visibility="{Binding HasTargetMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MidGreenBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetMessageError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource CreamCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total hemat vs mobil" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding SavedAllText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DeepGreenBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CreamCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Rata-rata per perjalanan" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding AverageText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DeepGreenBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CreamCard}">
                    <StackPanel>
                        <TextBlock Text="Moda favorit" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding FavoriteModeName}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DeepGreenBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Emisi 7 hari terakhir (kg CO₂)" FontWeight="SemiBold" FontSize="16"
                               Foreground="{StaticResource TextBrush}"/>
                    <ItemsControl ItemsSource="{Binding DailyBars}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DailyEmissionBarViewModel}">
                                <Grid Margin="6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <Grid Grid.Row="1">
                                        <Border Height="{Binding Ratio, Converter={StaticResource RatioToBarHeight}}"
                                                VerticalAlignment="Bottom" MaxWidth="46" CornerRadius="8,8,3,3"
                                                Background="{StaticResource MidGreenBrush}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="{Binding Label}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="CRoute.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CRoute.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Riwayat Perjalanan" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Hapus semua" Style="{StaticResource OutlineButton}"
                    Width="150" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding ClearCommand}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Trips}" ItemTemplate="{StaticResource TripRowTemplate}"/>
                </ScrollViewer>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🕘" FontSize="56" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="Riwayat masih kosong" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Simpan hasil pencarian rute dan perjalananmu akan muncul di sini."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Button Content="Cari rute" Style="{StaticResource PrimaryButton}"
                            Width="160" Margin="0,18,0,0" Command="{Binding GoToCariRuteCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

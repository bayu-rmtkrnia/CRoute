<Window x:Class="CRoute.App.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRoute.App.Views"
        xmlns:vm="clr-namespace:CRoute.App.ViewModels"
        xmlns:behaviors="clr-namespace:CRoute.App.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
        Title="CRoute - Daftar Akun" Width="940" Height="640" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HeroGradientBrush}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="420" Height="420" Fill="#14FFFFFF" HorizontalAlignment="Left"
                         VerticalAlignment="Bottom" Margin="-150,0,0,-170"/>
                <Ellipse Width="260" Height="260" Fill="#14FFFFFF" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,-90,-80,0"/>
                <StackPanel VerticalAlignment="Center" Margin="52,0,40,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LogoMark Width="52" Height="52"/>
                        <TextBlock Text="CRoute" FontSize="22" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock FontSize="38" FontWeight="ExtraBold" Foreground="White" LineHeight="46"
                               Margin="0,34,0,0">
                        <Run Text="Satu langkah kecil"/><LineBreak/><Run Text="untuk bumi,"/><LineBreak/><Run Text="dimulai dari sini." Foreground="#C9F27B"/>
                    </TextBlock>
                    <TextBlock Text="Buat akun untuk menyimpan riwayat perjalanan, memantau statistik, dan menetapkan target emisi bulananmu."
                               Foreground="#D6EBDD" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="52,24">
                <TextBlock Text="Buat akun baru" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Isi data di bawah, tidak sampai satu menit."
                           Style="{StaticResource Muted}" Margin="0,6,0,22"/>

                <TextBlock Text="Nama lengkap" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password (minimal 6 karakter)" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                <PasswordBox Style="{StaticResource InputPassword}"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password}"/>

                <TextBlock Text="Konfirmasi password" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                <PasswordBox Style="{StaticResource InputPassword}"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="Daftar" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                        Command="{Binding RegisterCommand}"/>
                <Button Content="Batal" IsCancel="True" Style="{StaticResource OutlineButton}" Margin="0,10,0,0"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

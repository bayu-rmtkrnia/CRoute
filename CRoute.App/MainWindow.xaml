<Window x:Class="CRoute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CRoute.App.Views"
        xmlns:vm="clr-namespace:CRoute.App.ViewModels"
        xmlns:services="clr-namespace:CRoute.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CRoute" Width="1120" Height="680" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HeroGradientBrush}" Padding="18,26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <views:LogoMark Width="40" Height="40"/>
                    <TextBlock Text="CRoute" FontSize="20" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Menu: IsChecked mengikuti CurrentPage, klik menjalankan NavigateCommand -->
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Content="🏠   Dashboard"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualityToBoolean}, ConverterParameter={x:Static services:AppPage.Dashboard}}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static services:AppPage.Dashboard}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Content="🧭   Cek Rute"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualityToBoolean}, ConverterParameter={x:Static services:AppPage.CariRute}}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static services:AppPage.CariRute}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Content="🕘   Riwayat"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualityToBoolean}, ConverterParameter={x:Static services:AppPage.History}}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static services:AppPage.History}"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItem}" Content="📊   Statistik &amp; Target"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualityToBoolean}, ConverterParameter={x:Static services:AppPage.Stats}}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static services:AppPage.Stats}"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#1FFFFFFF" CornerRadius="14" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="19" Background="White">
                                <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource DeepGreenBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserFullName}" Foreground="White" FontWeight="SemiBold"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Pengguna CRoute" Foreground="#BFDCC8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Keluar" Style="{StaticResource LightOutlineButton}"
                            Margin="0,12,0,0" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Halaman aktif; View dipilih otomatis dari DataTemplate di App.xaml -->
        <ContentControl Grid.Column="1" Margin="32,26,24,20" Content="{Binding CurrentPageViewModel}"/>
    </Grid>
</Window>

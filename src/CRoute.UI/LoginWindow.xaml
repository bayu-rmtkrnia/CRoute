<Window x:Class="CRoute.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRoute.UI"
        Title="CRoute - Login" Width="940" Height="600" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HeroGradientBrush}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="420" Height="420" Fill="#14FFFFFF" HorizontalAlignment="Left"
                         VerticalAlignment="Bottom" Margin="-150,0,0,-170"/>
                <Ellipse Width="260" Height="260" Fill="#14FFFFFF" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,-90,-80,0"/>
                <StackPanel VerticalAlignment="Center" Margin="52,0,40,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LogoMark Width="52" Height="52"/>
                        <TextBlock Text="CRoute" FontSize="22" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock FontSize="38" FontWeight="ExtraBold" Foreground="White" LineHeight="46"
                               Margin="0,34,0,0">
                        <Run Text="Tiap perjalanan"/><LineBreak/><Run Text="ninggalin jejak"/><LineBreak/><Run Text="karbon, lho." Foreground="#C9F27B"/>
                    </TextBlock>
                    <TextBlock Text="Sebelum berangkat, intip dulu berapa CO₂ yang kamu hasilkan. Moda transportasinya, kamu yang pilih."
                               Foreground="#D6EBDD" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Text="🚗  🏍  🚌  🚆  🚲  🚶" FontSize="22" Foreground="#E8F6EC" Margin="0,26,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="52,24">
                <TextBlock Text="Selamat datang kembali" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Masuk untuk lanjut membandingkan rute ramah lingkungan."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,26"/>

                <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <TextBox x:Name="tbUsername" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="pbPassword" Style="{StaticResource InputPassword}"/>

                <TextBlock x:Name="tbError" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button x:Name="btnLogin" Content="Login" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Click="btnLogin_Click"/>
                <Button x:Name="btnClose" Content="Close"
                        Style="{StaticResource OutlineButton}" Margin="0,10,0,0" Click="btnClose_Click"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0"
                           Foreground="{StaticResource MutedBrush}">
                    <Run Text="Belum punya akun? "/>
                    <Hyperlink x:Name="lnkRegister" Click="lnkRegister_Click"
                               Foreground="{StaticResource MidGreenBrush}">Daftar di sini</Hyperlink>
                </TextBlock>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<Window x:Class="CRoute.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRoute.UI"
        Title="CRoute" Width="1120" Height="680" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HeroGradientBrush}" Padding="18,26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <local:LogoMark Width="40" Height="40"/>
                    <TextBlock Text="CRoute" FontSize="20" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <RadioButton x:Name="navDashboard" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="🏠   Dashboard" IsChecked="True" Click="navDashboard_Click"/>
                    <RadioButton x:Name="navRoute" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="🧭   Cek Rute" Click="navRoute_Click"/>
                    <RadioButton x:Name="navHistory" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="🕘   Riwayat" Click="navHistory_Click"/>
                    <RadioButton x:Name="navStats" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="📊   Statistik &amp; Target" Click="navStats_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#1FFFFFFF" CornerRadius="14" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="19" Background="White">
                                <TextBlock x:Name="tbInitial" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource DeepGreenBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="tbUserName" Foreground="White" FontWeight="SemiBold"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Pengguna CRoute" Foreground="#BFDCC8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnLogout" Content="Keluar" Style="{StaticResource LightOutlineButton}"
                            Margin="0,12,0,0" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="contentHost" Grid.Column="1" Margin="32,26,24,20"/>
    </Grid>
</Window>

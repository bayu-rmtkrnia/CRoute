<UserControl x:Class="CRoute.UI.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Riwayat Perjalanan" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="tbCount" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="btnClear" Content="Hapus semua" Style="{StaticResource OutlineButton}"
                    Width="150" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="btnClear_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid>
                <ScrollViewer x:Name="svList" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icHistory" ItemTemplate="{StaticResource TripRowTemplate}"/>
                </ScrollViewer>
                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="🕘" FontSize="56" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="Riwayat masih kosong" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Simpan hasil pencarian rute dan perjalananmu akan muncul di sini."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Button x:Name="btnGoSearch" Content="Cari rute" Style="{StaticResource PrimaryButton}"
                            Width="160" Margin="0,18,0,0" Click="btnGoSearch_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

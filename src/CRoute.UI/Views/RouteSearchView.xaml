<UserControl x:Class="CRoute.UI.RouteSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cek Rute" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Bandingkan emisi karbon setiap moda untuk satu perjalanan."
                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Lokasi asal" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="tbOrigin" Style="{StaticResource InputBox}"
                                 ToolTip="Contoh: Jl. Kaliurang, Sleman"/>

                        <TextBlock Text="Lokasi tujuan" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                        <TextBox x:Name="tbDestination" Style="{StaticResource InputBox}"
                                 ToolTip="Contoh: UGM, Bulaksumur"/>

                        <TextBlock Text="Moda yang dibandingkan" Style="{StaticResource Muted}" Margin="0,18,0,8"/>
                        <WrapPanel x:Name="wpModes"/>

                        <TextBlock x:Name="tbError" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Button x:Name="btnCompare" Content="Bandingkan emisi" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                Click="btnCompare_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Border x:Name="pnlEmpty" Style="{StaticResource Card}" Background="{StaticResource CreamBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🗺️" FontSize="64" HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Belum ada hasil" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Isi lokasi asal dan tujuan, lalu klik Bandingkan emisi."
                                   Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="pnlResult" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="tbRoute" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="tbRouteInfo" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                            <Border Background="{StaticResource PastelHeroBrush}" CornerRadius="16"
                                    Padding="18,14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="tbRecTitle" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource DeepGreenBrush}"/>
                                    <TextBlock x:Name="tbRecDetail" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Perbandingan emisi per moda (kg CO₂)" Style="{StaticResource Muted}"
                                       Margin="0,20,0,6"/>
                            <ItemsControl x:Name="icResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="86"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModeName}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Badge}" FontSize="10"
                                                           Foreground="{StaticResource MidGreenBrush}"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="2" Style="{StaticResource SoftProgress}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{Binding BarBrush}"
                                                         Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EmissionText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="btnSave" Content="Simpan ke riwayat"
                                        Style="{StaticResource PrimaryButton}" Width="210" Click="btnSave_Click"/>
                                <Button x:Name="btnHistory" Content="Lihat riwayat"
                                        Style="{StaticResource OutlineButton}" Width="150" Margin="12,0,0,0"
                                        Visibility="Collapsed" Click="btnHistory_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

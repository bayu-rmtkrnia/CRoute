<UserControl x:Class="CRoute.UI.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,12">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="tbGreeting" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="Mau ke mana hari ini? Cek dulu jejak karbonnya sebelum jalan."
                               Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="tbDate" Style="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource PastelHeroBrush}"
                    Padding="28" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cek Jejak Perjalananmu" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource DeepGreenBrush}"/>
                        <TextBlock Text="Masukkan lokasi asal dan tujuan, CRoute membandingkan emisi CO₂ semua moda sekaligus."
                                    Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="440"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,18"/>
                        <Button x:Name="btnSearch" Content="Yuk, cek sekarang  →"
                                Style="{StaticResource PrimaryButton}" Width="220"
                                HorizontalAlignment="Left" Click="btnSearch_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🌿" FontSize="86" Opacity="0.55"
                               VerticalAlignment="Center" Margin="20,0,10,0"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource CreamCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Emisi bulan ini" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="tbMonthTotal" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DeepGreenBrush}"/>
                            <TextBlock Text=" kg CO₂" Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CreamCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Hemat dibanding naik mobil" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="tbSaved" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DeepGreenBrush}"/>
                            <TextBlock Text=" kg CO₂" Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CreamCard}">
                    <StackPanel>
                        <TextBlock Text="Perjalananmu" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="tbTripCount" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DeepGreenBrush}"/>
                            <TextBlock Text=" trip" Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Target emisi bulanan" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="tbTargetStatus" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                        <ProgressBar x:Name="pbTarget" Style="{StaticResource SoftProgress}" Height="12"
                                     Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="tbTargetDetail" Style="{StaticResource Muted}" FontSize="12"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="btnTarget" Grid.Column="1" Content="Atur target"
                            Style="{StaticResource OutlineButton}" Width="140" VerticalAlignment="Center"
                            Margin="28,0,0,0" Click="btnTarget_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Perjalanan terakhir" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="btnAll" Content="Lihat semua" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Click="btnAll_Click"/>
                    </Grid>
                    <ItemsControl x:Name="icRecent" ItemTemplate="{StaticResource TripRowTemplate}"
                                  Margin="0,8,0,0"/>
                    <TextBlock x:Name="tbEmptyRecent" Text="Belum ada perjalanan. Cek rute pertamamu, yuk!"
                               Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource ChipBgBrush}" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="26" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="Tahukah kamu?" FontWeight="SemiBold"
                                   Foreground="{StaticResource DeepGreenBrush}"/>
                        <TextBlock Text="Menurut perhitungan estimasi CRoute, 10 km naik bus bisa hemat sekitar 0,8 kg CO₂ dibanding mobil pribadi. Kelihatannya kecil, tapi kalau tiap hari, lama-lama jadi banyak."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

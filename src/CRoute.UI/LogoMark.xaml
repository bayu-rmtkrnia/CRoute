<UserControl x:Class="CRoute.UI.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <Viewbox Stretch="Uniform">
        <Canvas Width="680" Height="680">
            <Ellipse Canvas.Left="40" Canvas.Top="40" Width="600" Height="600">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2F8A60" Offset="0"/>
                        <GradientStop Color="#8CCB7E" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Fill="White"
                  Data="M340,170 C425,170 490,235 490,318 C490,420 340,560 340,560 C340,560 190,420 190,318 C190,235 255,170 340,170 Z"/>
            <Path Stroke="#33414B" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M340,540 L340,300"/>
            <Path Stroke="White" StrokeThickness="4" StrokeDashArray="3 2.5" Data="M340,540 L340,300"/>
            <Path Data="M340,220 C380,225 405,255 405,290 C405,320 375,335 340,318 C305,335 275,320 275,290 C275,255 300,225 340,220 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A8E06C" Offset="0"/>
                        <GradientStop Color="#2F8F4E" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
